{
  "categories": [
    {
      "id": "themes",
      "title": "Themes",
      "description": "Wallpapers and colour schemes",
      "icon": "preferences-desktop-theme",
      "view": "themes"
    },
    {
      "id": "updates",
      "title": "Updates",
      "description": "Updates, cleanup and system repair",
      "icon": "system-software-update",
      "actions": [
        { "id": "update-system", "title": "System update",
          "description": "Refresh the databases and upgrade everything (pacman -Syu)",
          "script": "update-system.sh", "escalate": true },
        { "id": "clear-pkg-cache", "title": "Clear package cache",
          "description": "Keep the two newest versions of each package",
          "script": "clear-pkg-cache.sh", "escalate": true },
        { "id": "clear-user-cache", "title": "Clear user cache",
          "description": "Empty ~/.cache and the Trash",
          "script": "clear-user-cache.sh",
          "confirm": "This deletes everything in ~/.cache and your Trash. Continue?" },
        { "id": "kernel-lock", "title": "Lock kernels",
          "description": "Hold installed kernels back from updates",
          "script": "kernel-lock.sh", "args": "lock", "escalate": true,
          "confirm": "The installed kernel packages will be excluded from system updates until you unlock them. Continue?" },
        { "id": "kernel-unlock", "title": "Unlock kernels",
          "description": "Allow kernel updates again",
          "script": "kernel-lock.sh", "args": "unlock", "escalate": true },
        { "id": "grub-rebuild", "title": "Rebuild GRUB config",
          "description": "grub-mkconfig -o /boot/grub/grub.cfg",
          "script": "grub-rebuild.sh", "escalate": true },
        { "id": "repair-plasma", "title": "Repair Plasma",
          "description": "Reinstall the installed Plasma / KDE workspace packages",
          "script": "repair-plasma.sh", "escalate": true,
          "confirm": "This reinstalls all installed Plasma workspace packages. Continue?" },
        { "id": "restart-plasma", "title": "Restart Plasma shell",
          "description": "Fix a frozen panel without logging out",
          "script": "restart-plasma.sh" }
      ]
    },
    {
      "id": "drivers",
      "title": "GPU Drivers",
      "description": "Multilib and Intel / AMD / NVIDIA drivers",
      "icon": "preferences-desktop-display",
      "actions": [
        { "id": "multilib-on", "title": "Enable multilib",
          "description": "32-bit libraries for Steam, Wine and games",
          "script": "multilib.sh", "args": "on", "escalate": true },
        { "id": "multilib-off", "title": "Disable multilib",
          "description": "Turn the [multilib] repository off",
          "script": "multilib.sh", "args": "off", "escalate": true },
        { "id": "gpu-intel", "title": "Intel graphics",
          "description": "Mesa, Vulkan and the VA-API media driver",
          "script": "gpu.sh", "args": "intel", "escalate": true },
        { "id": "gpu-intel-compute", "title": "Intel + compute",
          "description": "Intel graphics plus the OpenCL runtime",
          "script": "gpu.sh", "args": "intel-compute", "escalate": true },
        { "id": "gpu-amd", "title": "AMD graphics",
          "description": "Mesa with the RADV Vulkan driver",
          "script": "gpu.sh", "args": "amd", "escalate": true },
        { "id": "gpu-amd-xorg", "title": "AMD + Xorg",
          "description": "AMD graphics plus xf86-video-amdgpu",
          "script": "gpu.sh", "args": "amd-xorg", "escalate": true },
        { "id": "gpu-nvidia-open", "title": "NVIDIA open",
          "description": "nvidia-open-dkms, RTX / GTX 16 and newer",
          "script": "gpu.sh", "args": "nvidia-open", "escalate": true },
        { "id": "gpu-nvidia-dkms", "title": "NVIDIA proprietary",
          "description": "nvidia-dkms (very old cards may need an AUR legacy driver)",
          "script": "gpu.sh", "args": "nvidia-dkms", "escalate": true },
        { "id": "gpu-nvidia-lts", "title": "NVIDIA for LTS",
          "description": "nvidia-lts for the linux-lts kernel",
          "script": "gpu.sh", "args": "nvidia-lts", "escalate": true }
      ]
    },
    {
      "id": "repos",
      "title": "Repositories",
      "description": "Convert, add and switch repositories",
      "icon": "network-server",
      "actions": [
        { "id": "cachyos-convert", "title": "Convert Arch to CachyOS",
          "description": "Official cachyos-repo script: CachyOS repos with CPU-optimised packages",
          "script": "cachyos-convert.sh", "escalate": true,
          "confirm": "This downloads and runs the official cachyos-repo script as root and switches your package repositories to CachyOS. Continue?" },
        { "id": "cachyos-kernel", "title": "Install CachyOS kernel",
          "description": "linux-cachyos + headers (CachyOS repos required)",
          "script": "cachyos-kernel.sh", "escalate": true },
        { "id": "chaotic-add", "title": "Add Chaotic-AUR",
          "description": "Prebuilt AUR packages: keyring, mirrorlist and repo",
          "script": "chaotic-add.sh", "escalate": true,
          "confirm": "This imports the Chaotic-AUR signing key and adds the repository to pacman.conf. Continue?" },
        { "id": "chaotic-remove", "title": "Remove Chaotic-AUR",
          "description": "Disable the [chaotic-aur] repository",
          "script": "repos.sh", "args": "chaotic-off", "escalate": true },
        { "id": "reflector", "title": "Rank Arch mirrors",
          "description": "Fastest 20 HTTPS mirrors with reflector",
          "script": "reflector.sh", "escalate": true },
        { "id": "repos-testing", "title": "Arch testing repos",
          "description": "core-testing, extra-testing, multilib-testing",
          "script": "repos.sh", "args": "testing", "escalate": true,
          "confirm": "Testing repositories can break your system. Enable them?" },
        { "id": "repos-kde-unstable", "title": "KDE unstable",
          "description": "Testing repos plus kde-unstable (newest Plasma)",
          "script": "repos.sh", "args": "kde-unstable", "escalate": true,
          "confirm": "Unstable repositories can break your desktop. Enable them?" },
        { "id": "repos-multilib-testing", "title": "Multilib testing",
          "description": "Needs multilib to be enabled first",
          "script": "repos.sh", "args": "multilib-testing", "escalate": true },
        { "id": "repos-stable", "title": "Back to stable",
          "description": "Disable testing and unstable repos (multilib stays as it is)",
          "script": "repos.sh", "args": "stable", "escalate": true }
      ]
    },
    {
      "id": "codex",
      "title": "Claude Codex",
      "description": "The claude-codex terminal app",
      "icon": "utilities-terminal",
      "actions": [
        { "id": "claude-codex", "title": "Open Claude Codex",
          "description": "Runs claude-codex in Konsole",
          "kind": "tui", "program": "claude-codex" }
      ]
    },
    {
      "id": "tools",
      "title": "Tools",
      "description": "Convert, add and launch things",
      "icon": "applications-utilities",
      "actions": [
        { "id": "appimage", "title": "Add AppImage to menu",
          "description": "Convert an AppImage into an application menu entry with its icon",
          "kind": "appimage" },
        { "id": "dns", "title": "DNS settings",
          "description": "Change DNS provider, DoT / DoH / DoQ",
          "kind": "page", "page": "dns", "requires": "nmcli" },
        { "id": "sysinfo", "title": "System information",
          "description": "OS, kernel, packages, CPU, GPU, memory, disk",
          "script": "sysinfo.sh" },
        { "id": "konsole", "title": "Konsole",
          "description": "Open a terminal", "kind": "launch", "program": "konsole" },
        { "id": "dolphin", "title": "Dolphin",
          "description": "Open the file manager", "kind": "launch", "program": "dolphin" },
        { "id": "system-monitor", "title": "System Monitor",
          "description": "Plasma System Monitor", "kind": "launch", "program": "plasma-systemmonitor" },
        { "id": "overview", "title": "Plasma Overview",
          "description": "Show the KWin overview effect", "kind": "launch",
          "program": "qdbus6", "arguments": ["org.kde.kglobalaccel", "/component/kwin", "invokeShortcut", "Overview"] },
        { "id": "volume-up", "title": "Volume +20%",
          "description": "Raise the output volume", "kind": "launch",
          "program": "wpctl", "arguments": ["set-volume", "-l", "1.5", "@DEFAULT_AUDIO_SINK@", "20%+"], "requires": "wpctl" },
        { "id": "volume-down", "title": "Volume -20%",
          "description": "Lower the output volume", "kind": "launch",
          "program": "wpctl", "arguments": ["set-volume", "@DEFAULT_AUDIO_SINK@", "20%-"], "requires": "wpctl" },
        { "id": "bauh", "title": "Bauh",
          "description": "AppImage / Flatpak / AUR manager", "kind": "launch",
          "program": "bauh", "requires": "bauh" },
        { "id": "stacer", "title": "Stacer",
          "description": "System optimiser and monitor", "kind": "launch",
          "program": "stacer", "requires": "stacer" },
        { "id": "website", "title": "claudemods website",
          "description": "claudemodsreloaded.co.uk", "kind": "url", "url": "https://claudemodsreloaded.co.uk" },
        { "id": "github", "title": "claudemods on GitHub",
          "description": "Source code and releases", "kind": "url", "url": "https://github.com/claudemods" }
      ]
    }
  ]
}
